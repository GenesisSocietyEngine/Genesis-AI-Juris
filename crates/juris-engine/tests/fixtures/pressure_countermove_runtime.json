{
  "schema_version": "1.0",
  "metadata": {
    "id": "pressure-countermove-runtime-test",
    "title": "Pressure and Countermove Runtime Test",
    "summary": "Test-only deterministic pressure fixture.",
    "content_version": "1.0.0",
    "tags": ["test", "pressure-countermove"]
  },
  "jurisdiction": {
    "code": "TEST",
    "pack_version": "test-1"
  },
  "initial_stage": "active",
  "clock": {
    "mode": "foreground"
  },
  "numeric_metrics": {
    "countermove_cost": 0
  },
  "actors": [
    {
      "id": "opposing-counsel",
      "name": "Opposing Counsel",
      "role": "opposing_counsel"
    }
  ],
  "facts": [],
  "evidence": [],
  "stages": [
    {
      "id": "active",
      "title": "Active Matter",
      "kind": "standard",
      "exit_actions": [
        "receive-demand",
        "file-documented-response",
        "negotiate-extension",
        "close-matter"
      ],
      "terminal": false
    },
    {
      "id": "resolved",
      "title": "Resolved",
      "kind": "resolved",
      "entry_event": "matter-closed",
      "exit_actions": [],
      "terminal": true
    }
  ],
  "actions": [
    {
      "id": "receive-demand",
      "title": "Receive urgent demand",
      "description": "Activates the response pressure.",
      "available_when": {
        "type": "stage_is",
        "stage": "active"
      },
      "time_cost_minutes": 0,
      "repeatability": {
        "type": "once"
      }
    },
    {
      "id": "file-documented-response",
      "title": "File documented response",
      "description": "Completes the response within the deadline.",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "active"
          },
          {
            "type": "deadline_status_is",
            "deadline": "response-window",
            "status": "open"
          }
        ]
      },
      "effects": [
        {
          "type": "set_flag",
          "flag": "documented_response",
          "value": true
        }
      ],
      "time_cost_minutes": 30,
      "completion_deadlines": ["response-window"],
      "repeatability": {
        "type": "once"
      }
    },
    {
      "id": "negotiate-extension",
      "title": "Negotiate extension",
      "description": "Uses a second valid response path.",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "active"
          },
          {
            "type": "deadline_status_is",
            "deadline": "response-window",
            "status": "open"
          }
        ]
      },
      "effects": [
        {
          "type": "set_flag",
          "flag": "extension_negotiated",
          "value": true
        }
      ],
      "time_cost_minutes": 15,
      "completion_deadlines": ["response-window"],
      "repeatability": {
        "type": "once"
      }
    },
    {
      "id": "close-matter",
      "title": "Close matter",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "active"
          },
          {
            "type": "any",
            "conditions": [
              {
                "type": "deadline_status_is",
                "deadline": "response-window",
                "status": "completed"
              },
              {
                "type": "deadline_status_is",
                "deadline": "response-window",
                "status": "missed"
              }
            ]
          }
        ]
      },
      "effects": [
        {
          "type": "set_stage",
          "stage": "resolved"
        },
        {
          "type": "trigger_event",
          "event": "matter-closed"
        }
      ],
      "time_cost_minutes": 0,
      "repeatability": {
        "type": "once"
      }
    }
  ],
  "deadlines": [
    {
      "id": "response-window",
      "title": "Urgent response deadline",
      "due_at": {
        "day": 0,
        "minute_of_day": 60
      },
      "completion_at_due_allowed": false,
      "activation_event": "pressure-opened",
      "completion_actions": [
        "file-documented-response",
        "negotiate-extension"
      ],
      "missed_event": "countermove"
    }
  ],
  "pressure_windows": [
    {
      "id": "urgent-demand",
      "source_actor_id": "opposing-counsel",
      "activation_event_id": "pressure-opened",
      "response_deadline_id": "response-window",
      "countermove_event_id": "countermove",
      "response_action_ids": [
        "file-documented-response",
        "negotiate-extension"
      ]
    }
  ],
  "async_tasks": [],
  "inbox_items": [
    {
      "id": "countermove-notice",
      "sender": "Opposing Counsel",
      "subject": "Countermove executed",
      "body": "The response window expired and the opposing side acted.",
      "created_by_event": "countermove",
      "initially_visible": false,
      "action_required": false,
      "resolution_actions": []
    }
  ],
  "events": [
    {
      "id": "pressure-opened",
      "title": "Pressure opened",
      "kind": "generic",
      "trigger": {
        "type": "after_action",
        "action": "receive-demand"
      },
      "condition": {
        "type": "always"
      },
      "effects": []
    },
    {
      "id": "countermove",
      "title": "Countermove",
      "kind": "generic",
      "trigger": {
        "type": "deadline_missed",
        "deadline": "response-window"
      },
      "condition": {
        "type": "always"
      },
      "effects": [
        {
          "type": "miss_deadline",
          "deadline": "response-window"
        },
        {
          "type": "add_metric",
          "metric": "countermove_cost",
          "amount": 25
        },
        {
          "type": "create_inbox_item",
          "item": "countermove-notice"
        }
      ]
    },
    {
      "id": "matter-closed",
      "title": "Matter closed",
      "kind": "matter_closed",
      "trigger": {
        "type": "by_effect"
      },
      "condition": {
        "type": "stage_is",
        "stage": "resolved"
      },
      "effects": [
        {
          "type": "resolve_outcome",
          "outcome": "finished"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "finished",
      "title": "Finished",
      "summary": "The test matter finished.",
      "terminal_stage": "resolved",
      "condition": {
        "type": "stage_is",
        "stage": "resolved"
      }
    }
  ]
}
