{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Juris: run v0.4 assisted workday",
      "type": "shell",
      "command": "cargo run -p juris-cli -- start-day --mode assisted --seed 20260724",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Juris: test workspace",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Juris: format workspace",
      "type": "shell",
      "command": "cargo fmt --all",
      "problemMatcher": []
    },
    {
      "label": "Juris: quality gate",
      "type": "shell",
      "command": "cargo fmt --all -- --check && cargo check --workspace && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
      "problemMatcher": ["$rustc"]
    }
  ]
}
