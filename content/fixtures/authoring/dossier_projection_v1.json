{
  "schema_version": "1.0",
  "metadata": {
    "id": "dossier_projection_v1_fixture",
    "title": "Dossier Projection v1 Fixture",
    "summary": "Focused non-production fixture for deterministic dossier filtering and lifecycle projection.",
    "content_version": "1",
    "tags": ["fixture", "dossier", "projection"]
  },
  "jurisdiction": {
    "code": "BE",
    "pack_version": "1"
  },
  "clock": {
    "mode": "foreground"
  },
  "initial_stage": "investigation",
  "facts": [
    {
      "id": "z_known_fact",
      "statement": "The filing record was received.",
      "initial_status": "alleged"
    },
    {
      "id": "sentinel_unknown_fact",
      "statement": "SENTINEL UNKNOWN FACT MUST NOT LEAK",
      "initial_status": "unknown"
    },
    {
      "id": "a_known_fact",
      "statement": "The client retained counsel.",
      "initial_status": "proven"
    }
  ],
  "evidence": [
    {
      "id": "z_visible_evidence",
      "title": "Filed registry extract",
      "kind": "document",
      "description": "A registry extract available at intake.",
      "supports_facts": ["sentinel_unknown_fact", "z_known_fact", "z_known_fact"],
      "contradicts_facts": ["a_known_fact"],
      "initially_available": true
    },
    {
      "id": "sentinel_unavailable_evidence",
      "title": "SENTINEL UNAVAILABLE EVIDENCE MUST NOT LEAK",
      "kind": "email",
      "description": "SENTINEL UNAVAILABLE DESCRIPTION MUST NOT LEAK",
      "supports_facts": ["sentinel_unknown_fact"],
      "initially_available": false
    },
    {
      "id": "a_visible_evidence",
      "title": "Engagement letter",
      "kind": "contract",
      "supports_facts": ["a_known_fact"],
      "initially_available": true
    }
  ],
  "stages": [
    {
      "id": "investigation",
      "title": "Investigation",
      "kind": "standard",
      "exit_actions": ["z_reveal_record", "a_receive_adverse_decision"]
    },
    {
      "id": "post_judgment",
      "title": "Post-judgment remedies",
      "kind": "post_judgment",
      "exit_actions": [
        "preserve_review_rights",
        "file_appeal",
        "accept_final_loss",
        "close_after_expiry",
        "sentinel_future_activation_action",
        "sentinel_future_remedy_action"
      ]
    },
    {
      "id": "appeal",
      "title": "Appeal",
      "kind": "appeal",
      "exit_actions": ["resolve_appeal_and_close"]
    },
    {
      "id": "resolved",
      "title": "Resolved",
      "kind": "resolved",
      "terminal": true
    }
  ],
  "actions": [
    {
      "id": "z_reveal_record",
      "title": "Review sealed record",
      "description": "Review the sealed record and add disclosed material to the dossier.",
      "available_when": {
        "type": "stage_is",
        "stage": "investigation"
      },
      "effects": [
        {
          "type": "set_fact_status",
          "fact": "sentinel_unknown_fact",
          "status": "disputed"
        },
        {
          "type": "make_evidence_available",
          "evidence": "sentinel_unavailable_evidence"
        },
        {
          "type": "set_flag",
          "flag": "sentinel_private_flag",
          "value": true
        }
      ],
      "time_cost_minutes": 10,
      "cost_eur": 125
    },
    {
      "id": "a_receive_adverse_decision",
      "title": "Receive adverse decision",
      "available_when": {
        "type": "stage_is",
        "stage": "investigation"
      },
      "effects": [
        {
          "type": "trigger_event",
          "event": "adverse_decision_delivered"
        }
      ],
      "time_cost_minutes": 20
    },
    {
      "id": "preserve_review_rights",
      "title": "Preserve review rights",
      "description": "File the procedural reservation before the review deadline.",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "post_judgment"
          },
          {
            "type": "deadline_status_is",
            "deadline": "a_review_deadline",
            "status": "open"
          }
        ]
      },
      "effects": [
        {
          "type": "complete_deadline",
          "deadline": "a_review_deadline"
        }
      ],
      "time_cost_minutes": 15,
      "cost_eur": 400
    },
    {
      "id": "file_appeal",
      "title": "File appeal",
      "description": "File the appeal and preserve both active remedy windows.",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "post_judgment"
          },
          {
            "type": "deadline_status_is",
            "deadline": "z_appeal_deadline",
            "status": "open"
          },
          {
            "type": "judicial_result_is",
            "result": "lost"
          }
        ]
      },
      "effects": [
        {
          "type": "complete_deadline",
          "deadline": "a_review_deadline"
        },
        {
          "type": "complete_deadline",
          "deadline": "z_appeal_deadline"
        },
        {
          "type": "set_stage",
          "stage": "appeal"
        }
      ],
      "time_cost_minutes": 60,
      "cost_eur": 1800
    },
    {
      "id": "accept_final_loss",
      "title": "Accept result and close",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "post_judgment"
          },
          {
            "type": "judicial_result_is",
            "result": "lost"
          }
        ]
      },
      "effects": [
        {
          "type": "miss_deadline",
          "deadline": "a_review_deadline"
        },
        {
          "type": "miss_deadline",
          "deadline": "z_appeal_deadline"
        },
        {
          "type": "set_stage",
          "stage": "resolved"
        },
        {
          "type": "resolve_outcome",
          "outcome": "final_loss"
        }
      ],
      "time_cost_minutes": 5
    },
    {
      "id": "close_after_expiry",
      "title": "Close after remedies expire",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "post_judgment"
          },
          {
            "type": "deadline_status_is",
            "deadline": "a_review_deadline",
            "status": "missed"
          },
          {
            "type": "deadline_status_is",
            "deadline": "z_appeal_deadline",
            "status": "missed"
          }
        ]
      },
      "effects": [
        {
          "type": "set_stage",
          "stage": "resolved"
        },
        {
          "type": "resolve_outcome",
          "outcome": "final_loss"
        }
      ],
      "time_cost_minutes": 5
    },
    {
      "id": "resolve_appeal_and_close",
      "title": "Receive appellate judgment and close",
      "available_when": {
        "type": "stage_is",
        "stage": "appeal"
      },
      "effects": [
        {
          "type": "set_judicial_result",
          "result": "won"
        },
        {
          "type": "set_stage",
          "stage": "resolved"
        },
        {
          "type": "resolve_outcome",
          "outcome": "recovered_on_appeal"
        }
      ],
      "time_cost_minutes": 90
    },
    {
      "id": "sentinel_future_activation_action",
      "title": "SENTINEL FUTURE ACTION MUST NOT LEAK",
      "description": "SENTINEL FUTURE ACTION DESCRIPTION MUST NOT LEAK",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "post_judgment"
          },
          {
            "type": "flag_equals",
            "flag": "sentinel_future_gate",
            "value": true
          }
        ]
      },
      "effects": [
        {
          "type": "trigger_event",
          "event": "sentinel_unfired_event"
        }
      ]
    },
    {
      "id": "sentinel_future_remedy_action",
      "title": "SENTINEL FUTURE REMEDY MUST NOT LEAK",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "post_judgment"
          },
          {
            "type": "flag_equals",
            "flag": "sentinel_future_gate",
            "value": true
          },
          {
            "type": "deadline_status_is",
            "deadline": "sentinel_inactive_deadline",
            "status": "open"
          }
        ]
      },
      "effects": [
        {
          "type": "complete_deadline",
          "deadline": "sentinel_inactive_deadline"
        }
      ]
    }
  ],
  "deadlines": [
    {
      "id": "z_appeal_deadline",
      "title": "Appeal filing deadline",
      "due_at": {
        "day": 0,
        "minute_of_day": 300
      },
      "activation_event": "adverse_decision_delivered",
      "completion_actions": ["file_appeal"],
      "missed_event": "z_appeal_deadline_missed"
    },
    {
      "id": "sentinel_inactive_deadline",
      "title": "SENTINEL INACTIVE DEADLINE MUST NOT LEAK",
      "due_at": {
        "day": 0,
        "minute_of_day": 600
      },
      "activation_event": "sentinel_unfired_event",
      "completion_actions": ["sentinel_future_remedy_action"],
      "missed_event": "sentinel_inactive_deadline_missed"
    },
    {
      "id": "a_review_deadline",
      "title": "Review reservation deadline",
      "due_at": {
        "day": 0,
        "minute_of_day": 240
      },
      "activation_event": "adverse_decision_delivered",
      "completion_actions": ["preserve_review_rights", "file_appeal"],
      "missed_event": "a_review_deadline_missed"
    }
  ],
  "events": [
    {
      "id": "adverse_decision_delivered",
      "title": "Adverse decision delivered",
      "kind": "judgment",
      "trigger": {
        "type": "by_effect"
      },
      "effects": [
        {
          "type": "set_judicial_result",
          "result": "lost"
        },
        {
          "type": "set_stage",
          "stage": "post_judgment"
        }
      ]
    },
    {
      "id": "a_review_deadline_missed",
      "title": "Review reservation deadline missed",
      "kind": "generic",
      "trigger": {
        "type": "deadline_missed",
        "deadline": "a_review_deadline"
      },
      "effects": [
        {
          "type": "miss_deadline",
          "deadline": "a_review_deadline"
        }
      ]
    },
    {
      "id": "z_appeal_deadline_missed",
      "title": "Appeal filing deadline missed",
      "kind": "generic",
      "trigger": {
        "type": "deadline_missed",
        "deadline": "z_appeal_deadline"
      },
      "effects": [
        {
          "type": "miss_deadline",
          "deadline": "z_appeal_deadline"
        }
      ]
    },
    {
      "id": "sentinel_unfired_event",
      "title": "SENTINEL UNFIRED EVENT MUST NOT LEAK",
      "kind": "generic",
      "trigger": {
        "type": "by_effect"
      }
    },
    {
      "id": "sentinel_inactive_deadline_missed",
      "title": "SENTINEL INACTIVE MISSED EVENT MUST NOT LEAK",
      "kind": "generic",
      "trigger": {
        "type": "deadline_missed",
        "deadline": "sentinel_inactive_deadline"
      },
      "effects": [
        {
          "type": "miss_deadline",
          "deadline": "sentinel_inactive_deadline"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "final_loss",
      "title": "SENTINEL HIDDEN LOSS OUTCOME",
      "summary": "SENTINEL HIDDEN OUTCOME SUMMARY MUST NOT LEAK BEFORE CLOSURE",
      "terminal_stage": "resolved",
      "condition": {
        "type": "judicial_result_is",
        "result": "lost"
      }
    },
    {
      "id": "recovered_on_appeal",
      "title": "Recovered on appeal",
      "summary": "The appellate decision replaced the adverse first-instance result.",
      "terminal_stage": "resolved",
      "condition": {
        "type": "judicial_result_is",
        "result": "won"
      }
    }
  ]
}
