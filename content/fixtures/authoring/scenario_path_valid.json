{
  "schema_version": "1.0",
  "metadata": {
    "id": "authoring_path_valid",
    "title": "Asteron Systems NV v. Northbridge Consulting BV",
    "summary": "Deterministic authoring-path fixture.",
    "content_version": "1",
    "tags": [
      "fixture",
      "path_simulation"
    ]
  },
  "jurisdiction": {
    "code": "BE",
    "pack_version": "1"
  },
  "initial_stage": "intake",
  "stages": [
    {
      "id": "intake",
      "title": "Intake",
      "kind": "standard",
      "exit_actions": [
        "file_claim"
      ]
    },
    {
      "id": "proceedings",
      "title": "Proceedings",
      "kind": "standard",
      "exit_actions": [
        "prepare_hearing"
      ]
    },
    {
      "id": "post_judgment",
      "title": "Post-judgment",
      "kind": "post_judgment",
      "exit_actions": [
        "accept_judgment"
      ]
    },
    {
      "id": "resolved",
      "title": "Resolved",
      "kind": "resolved",
      "terminal": true
    }
  ],
  "actions": [
    {
      "id": "file_claim",
      "title": "File claim",
      "available_when": {
        "type": "stage_is",
        "stage": "intake"
      },
      "effects": [
        {
          "type": "set_flag",
          "flag": "claim_filed",
          "value": true
        },
        {
          "type": "set_stage",
          "stage": "proceedings"
        }
      ],
      "time_cost_minutes": 60
    },
    {
      "id": "prepare_hearing",
      "title": "Prepare hearing",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "proceedings"
          },
          {
            "type": "flag_equals",
            "flag": "claim_filed",
            "value": true
          }
        ]
      },
      "effects": [
        {
          "type": "trigger_event",
          "event": "judgment"
        }
      ],
      "time_cost_minutes": 180
    },
    {
      "id": "accept_judgment",
      "title": "Accept judgment and close",
      "available_when": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "post_judgment"
          },
          {
            "type": "flag_equals",
            "flag": "judgment_received",
            "value": true
          }
        ]
      },
      "effects": [
        {
          "type": "set_flag",
          "flag": "judgment_accepted",
          "value": true
        },
        {
          "type": "set_stage",
          "stage": "resolved"
        },
        {
          "type": "resolve_outcome",
          "outcome": "judgment_accepted"
        }
      ],
      "time_cost_minutes": 30
    }
  ],
  "events": [
    {
      "id": "judgment",
      "title": "First-instance judgment",
      "kind": "judgment",
      "trigger": {
        "type": "after_action",
        "action": "prepare_hearing"
      },
      "effects": [
        {
          "type": "set_flag",
          "flag": "judgment_received",
          "value": true
        },
        {
          "type": "set_stage",
          "stage": "post_judgment"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "judgment_accepted",
      "title": "Judgment accepted",
      "summary": "The client accepts the result and closes the matter.",
      "terminal_stage": "resolved",
      "condition": {
        "type": "all",
        "conditions": [
          {
            "type": "stage_is",
            "stage": "resolved"
          },
          {
            "type": "flag_equals",
            "flag": "judgment_accepted",
            "value": true
          }
        ]
      }
    }
  ]
}
