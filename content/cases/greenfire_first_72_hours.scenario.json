    {"id": "greenfire_industrial_solutions", "name": "GreenFire Industrial Solutions B.V.", "role": "client", "description": "Chemical-storage operator affected by the fire."},
    {"id": "eva_de_wit", "name": "Eva de Wit", "role": "witness", "description": "Managing director and primary client contact."},
    {"id": "daan_vermeer", "name": "Daan Vermeer", "role": "witness", "description": "Operations manager with knowledge of the affected storage site."},
    {"id": "port_haven_environment_authority", "name": "Port Haven Environmental Authority", "role": "opposing_party", "description": "Lead environmental regulator investigating the incident."},
