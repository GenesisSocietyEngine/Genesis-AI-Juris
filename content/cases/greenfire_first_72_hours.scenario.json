  "inbox_items": [
    {"id": "managing_director_emergency_call", "subject": "URGENT: Fire at the GreenFire storage site", "body": "A major fire has caused runoff, police attendance, regulatory inspection, and media attention.", "initially_visible": true, "action_required": true, "resolution_actions": ["accept_emergency_mandate"]},
