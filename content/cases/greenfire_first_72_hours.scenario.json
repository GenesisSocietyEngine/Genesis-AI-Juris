{
  "schema_version": "1.0",
  "metadata": {
    "id": "greenfire_first_72_hours",
    "title": "GreenFire — The First 72 Hours",
    "summary": "An industrial fire places a chemical-storage company under simultaneous criminal, regulatory, environmental, insurance, and insolvency pressure. Preserve evidence, control communications, protect coverage, manage conflicts, and hand over a defensible crisis position within 72 hours.",
    "content_version": "0.1.0",
    "author": "GENESIS: AI Juris",
    "tags": ["crisis_management", "environmental", "corporate_crime", "insurance", "netherlands", "fictional"]
  },
  "jurisdiction": {"code": "NL", "pack_version": "0.1.0"},
