        {"type": "trigger_event", "event": "mandate_accepted"},
        {"type": "set_stage", "stage": "immediate_response"}
      ],
      "time_cost_minutes": 30,
      "repeatability": {"type": "once"}
    },
    {
      "id": "issue_legal_hold",
      "title": "Issue an evidence-preservation hold",
      "description": "Preserve logs, CCTV, manifests, emails, maintenance data, and incident communications.",
      "available_when": {"type": "all", "conditions": [
        {"type": "stage_is", "stage": "immediate_response"},
        {"type": "flag_equals", "flag": "legal_hold_issued", "value": false}
      ]},
      "effects": [
        {"type": "set_flag", "flag": "legal_hold_issued", "value": true},
        {"type": "complete_deadline", "deadline": "legal_hold_deadline"},
        {"type": "resolve_inbox_item", "item": "legal_hold_required"}
      ],
      "time_cost_minutes": 90,
      "repeatability": {"type": "once"}
    },
    {
      "id": "run_conflict_assessment",
      "title": "Assess company/director conflicts",
