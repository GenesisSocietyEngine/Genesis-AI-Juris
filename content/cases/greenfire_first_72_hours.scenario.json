    {"id": "materials_outside_permit_zone", "statement": "Chemical materials may have been stored outside the permitted zone.", "initial_status": "unknown", "related_actors": ["greenfire_industrial_solutions", "port_haven_environment_authority"]},
    {"id": "safety_warning_not_escalated", "statement": "An internal safety warning may not have been escalated to management.", "initial_status": "unknown", "related_actors": ["greenfire_industrial_solutions", "eva_de_wit"]},
    {"id": "director_lacked_specific_operational_knowledge", "statement": "The managing director may have lacked specific knowledge of the site practice that preceded the fire.", "initial_status": "unknown", "related_actors": ["eva_de_wit", "daan_vermeer"]},
    {"id": "policy_notice_window", "statement": "Potentially responsive insurance policies require prompt incident notice.", "initial_status": "unknown", "related_actors": ["greenfire_industrial_solutions", "northsea_specialty_insurance"]}
  ],
