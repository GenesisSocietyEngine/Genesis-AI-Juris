{
  "format": "genesis-juris-dossier-contract-registry",
  "schema_version": 1,
  "registry": "genesis-juris-dossier-contract",
  "version": "1.0.0",
  "object_types": ["dossier", "participant", "status_transition", "document", "document_version", "source_anchor", "professional_assertion", "evidence_link", "information_request", "deadline_reference", "decision_package_reference", "ai_proposal", "dossier_snapshot", "governed_output", "audit_event"],
  "statuses": ["draft", "intake_review", "active", "awaiting_input", "internal_review", "output_approved", "closed", "archived", "declined", "cancelled"],
  "roles": ["owner", "contributor", "reviewer", "viewer"],
  "readiness_dimensions": ["document_completeness", "information_requests", "ai_proposals", "contradictions", "critical_deadlines", "source_provenance", "decision_graph", "simulation_tests", "report_freshness", "reviewer_approval"],
  "integrity_rules": ["graph_evidence_requires_exact_package", "transition_revision_and_output_binding", "audit_revision_receipt_chronology", "current_snapshot_exact_manifest", "private_output_content_reference", "sole_output_approval_freshness_exception"],
  "wire_enums": {
    "terminology": ["matter", "dossier", "engagement", "case"],
    "classification": ["public", "internal", "confidential", "strictly_confidential"],
    "priority": ["low", "normal", "high", "urgent"],
    "participant_status": ["active", "removed"],
    "document_source_origin": ["internal_upload", "external_reference", "import"],
    "document_status": ["received", "under_review", "accepted_source", "superseded", "rejected"],
    "document_media_type": ["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "text/plain", "text/markdown"],
    "extraction_status": ["queued", "processing", "ready", "failed", "not_extractable"],
    "extraction_error_code": ["unsupported_type", "image_only", "active_content", "malformed", "size_limit", "internal_error"],
    "anchor_creator": ["human", "ai_proposal", "import"],
    "review_state": ["pending", "accepted", "rejected", "superseded"],
    "assertion_type": ["fact", "evidence", "rule", "assumption", "date", "contradiction"],
    "assertion_status": ["accepted", "needs_review", "rejected", "superseded"],
    "evidence_target_type": ["professional_assertion", "authority_rule", "graph_node", "graph_edge", "parameter_assumption", "deadline", "report_section"],
    "evidence_relation": ["supports", "contradicts", "qualifies", "supersedes", "source_for"],
    "information_request_status": ["open", "received", "waived", "cancelled"],
    "deadline_kind": ["workspace", "projected_simulation"],
    "deadline_status": ["open", "completed", "waived", "cancelled"],
    "decision_package_state": ["current", "stale"],
    "graph_validation_status": ["not_run", "valid", "invalid"],
    "package_approval_state": ["draft", "reviewed", "approved", "published"],
    "proposal_type": ["document_metadata", "participant", "dated_event", "deadline", "fact", "authority_rule", "contradiction", "information_request", "evidence_link", "graph_change", "assumption", "dossier_summary"],
    "proposal_accepted_object_type": ["participant", "document", "professional_assertion", "evidence_link", "information_request", "deadline_reference", "decision_package_reference"],
    "confidence_category": ["low", "medium", "high"],
    "readiness_state": ["ready", "blocked", "not_applicable"],
    "audience": ["internal", "client"],
    "output_format": ["pdf", "json_manifest", "markdown"],
    "output_state": ["current", "stale"],
    "audit_actor_role": ["owner", "contributor", "reviewer", "viewer", "platform_admin", "system", "import"],
    "audit_event_type": ["dossier_created", "dossier_updated", "dossier_status_transitioned", "participant_changed", "document_created", "document_version_created", "source_anchor_reviewed", "assertion_reviewed", "evidence_link_changed", "information_request_changed", "proposal_reviewed", "proposal_generation_completed", "decision_package_linked", "snapshot_created", "output_generated", "output_approved", "output_marked_stale", "legacy_case_migration_requested", "admin_archive_override"]
  },
  "readiness_reasons": [
    { "code": "DOCUMENT_REQUIRED_MISSING", "dimension": "document_completeness", "explanation": "A required source document is missing.", "deep_link_prefix": "/documents" },
    { "code": "DOCUMENT_REVIEW_REQUIRED", "dimension": "document_completeness", "explanation": "A required document has not completed professional review.", "deep_link_prefix": "/documents" },
    { "code": "INFORMATION_REQUEST_OPEN", "dimension": "information_requests", "explanation": "Required information is still outstanding.", "deep_link_prefix": "/requests" },
    { "code": "INFORMATION_REQUEST_OVERDUE", "dimension": "information_requests", "explanation": "A required information request is overdue.", "deep_link_prefix": "/requests" },
    { "code": "AI_PROPOSAL_PENDING", "dimension": "ai_proposals", "explanation": "An AI proposal awaits explicit professional review.", "deep_link_prefix": "/evidence/proposals" },
    { "code": "CONTRADICTION_UNRESOLVED", "dimension": "contradictions", "explanation": "A material contradiction remains unresolved.", "deep_link_prefix": "/evidence/contradictions" },
    { "code": "CRITICAL_DEADLINE_MISSING", "dimension": "critical_deadlines", "explanation": "A required critical deadline has not been recorded.", "deep_link_prefix": "/requests-deadlines" },
    { "code": "CRITICAL_DEADLINE_OVERDUE", "dimension": "critical_deadlines", "explanation": "A critical workspace deadline is overdue.", "deep_link_prefix": "/requests-deadlines" },
    { "code": "SOURCE_ANCHOR_MISSING", "dimension": "source_provenance", "explanation": "An accepted professional assertion lacks exact source provenance.", "deep_link_prefix": "/evidence" },
    { "code": "SOURCE_VERSION_STALE", "dimension": "source_provenance", "explanation": "An accepted assertion depends on a superseded source version and requires review.", "deep_link_prefix": "/evidence" },
    { "code": "DECISION_GRAPH_INVALID", "dimension": "decision_graph", "explanation": "A linked decision graph has not passed canonical validation.", "deep_link_prefix": "/decision-packages" },
    { "code": "SIMULATION_REQUIRED", "dimension": "simulation_tests", "explanation": "A required deterministic simulation or package test has not run.", "deep_link_prefix": "/decision-packages" },
    { "code": "SIMULATION_FAILED", "dimension": "simulation_tests", "explanation": "A required deterministic simulation or package test failed.", "deep_link_prefix": "/decision-packages" },
    { "code": "OUTPUT_REQUIRED", "dimension": "report_freshness", "explanation": "A governed output has not been generated from the current dossier snapshot.", "deep_link_prefix": "/outputs" },
    { "code": "OUTPUT_STALE", "dimension": "report_freshness", "explanation": "The governed output does not represent the current authoritative dossier revision.", "deep_link_prefix": "/outputs" },
    { "code": "REVIEWER_APPROVAL_MISSING", "dimension": "reviewer_approval", "explanation": "The current governed output lacks an attributable reviewer approval.", "deep_link_prefix": "/outputs/approvals" }
  ],
  "transitions": [
    { "from": "draft", "to": "intake_review", "roles": ["owner", "contributor"], "requires": [], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "draft", "to": "declined", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "draft", "to": "cancelled", "roles": ["owner"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "intake_review", "to": "draft", "roles": ["owner", "contributor", "reviewer"], "requires": [], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "intake_review", "to": "active", "roles": ["owner", "reviewer"], "requires": [], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "intake_review", "to": "awaiting_input", "roles": ["owner", "contributor", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "intake_review", "to": "declined", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "intake_review", "to": "cancelled", "roles": ["owner"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "active", "to": "awaiting_input", "roles": ["owner", "contributor", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "active", "to": "internal_review", "roles": ["owner", "contributor", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "active", "to": "closed", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "active", "to": "cancelled", "roles": ["owner"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "awaiting_input", "to": "active", "roles": ["owner", "contributor", "reviewer"], "requires": [], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "awaiting_input", "to": "internal_review", "roles": ["owner", "contributor", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "awaiting_input", "to": "cancelled", "roles": ["owner"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "internal_review", "to": "active", "roles": ["owner", "contributor", "reviewer"], "requires": [], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "internal_review", "to": "awaiting_input", "roles": ["owner", "contributor", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "internal_review", "to": "output_approved", "roles": ["reviewer"], "requires": ["current_output", "reviewer_approval"], "consequences": ["recompute_readiness", "preserve_current_output"] },
    { "from": "internal_review", "to": "closed", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "output_approved", "to": "active", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "output_approved", "to": "closed", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "output_approved", "to": "cancelled", "roles": ["owner"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "closed", "to": "active", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "closed", "to": "archived", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "declined", "to": "active", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "declined", "to": "archived", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "cancelled", "to": "active", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "cancelled", "to": "archived", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] },
    { "from": "archived", "to": "active", "roles": ["owner", "reviewer"], "requires": ["reason"], "consequences": ["recompute_readiness", "mark_outputs_stale"] }
  ]
}
