# Transactional password-reset email (server-only; never expose these values to client code)
RESEND_API_KEY=re_xxxxxxxxx
GENESIS_RESET_FROM_EMAIL=GENESIS: JURIS <security@example.com>
GENESIS_PUBLIC_ORIGIN=https://your-production-origin.example

# INV01 uses a separate mailbox challenge; provider acceptance is not delivery.
# Leave disabled until the release owner has approved transport and test evidence.
GENESIS_INVITATION_MAIL_ENABLED=false
GENESIS_INVITATION_FROM_EMAIL=GENESIS: JURIS <invitations@example.com>

# Comma-separated trusted ChatGPT identity emails that may administer the platform.
GENESIS_ADMIN_EMAILS=admin@example.com

# Operational release identity. Production must use the exact saved Site version and 40-character pushed Git SHA.
GENESIS_DEPLOYMENT_VERSION=local
GENESIS_WEB_COMMIT=unknown

# AI-assisted Studio planning (server-only). The model must support Responses API Structured Outputs.
OPENAI_API_KEY=sk-proj-xxxxxxxxx
GENESIS_OPENAI_MODEL=gpt-5.6
GENESIS_AI_DAILY_REQUEST_LIMIT=500
