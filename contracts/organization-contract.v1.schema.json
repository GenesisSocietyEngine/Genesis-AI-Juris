{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesis.invalid/contracts/organization-contract.v1.schema.json",
  "title": "GENESIS JURIS organization contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "organization", "authorization"],
  "properties": {
    "contract_version": { "const": "organization-contract.v1" },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "slug", "status", "controller_processor_mode", "data_region", "confidential_document_mode", "policy_versions"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63 },
        "status": { "enum": ["provisioning", "active", "suspended", "closed"] },
        "controller_processor_mode": { "enum": ["controller", "processor", "joint_controller"] },
        "data_region": { "const": "eu" },
        "confidential_document_mode": { "enum": ["disabled", "validation", "approved"] },
        "policy_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retention", "deletion", "export", "legal_hold", "offline_mobile", "ai_disclosure", "session", "data_classification"],
          "properties": {
            "retention": { "$ref": "#/$defs/version" },
            "deletion": { "$ref": "#/$defs/version" },
            "export": { "$ref": "#/$defs/version" },
            "legal_hold": { "$ref": "#/$defs/version" },
            "offline_mobile": { "$ref": "#/$defs/version" },
            "ai_disclosure": { "$ref": "#/$defs/version" },
            "session": { "$ref": "#/$defs/version" },
            "data_classification": { "$ref": "#/$defs/version" }
          }
        },
        "suspension_reason": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "action"],
      "properties": {
        "organization_role": { "enum": ["org_owner", "org_admin", "member", "auditor"] },
        "authorization_version": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["identity", "organization", "dossier"] },
        "action": {
          "enum": [
            "oidc_callback", "invitation_acceptance",
            "organization_read", "organization_update", "member_invite", "member_suspend",
            "member_remove", "member_role_assign", "identity_connection_read",
            "identity_connection_manage", "policy_read", "policy_manage",
            "organization_audit_read", "tenant_export_request",
            "dossier_read", "dossier_update", "dossier_member_enrol",
            "dossier_member_remove", "dossier_owner_transfer", "document_upload",
            "document_read", "document_delete_request", "extraction_request",
            "ocr_request", "citation_read", "citation_manage", "evidence_read",
            "evidence_manage", "task_read", "task_manage", "review_read",
            "review_submit", "report_read", "report_generate", "dossier_export_request",
            "retention_purge_request", "legal_hold_read", "legal_hold_create_request",
            "legal_hold_create_approve", "legal_hold_release_request",
            "legal_hold_release_approve", "dossier_audit_read"
          ]
        },
        "dossier_role": { "enum": ["owner", "contributor", "reviewer", "viewer"] },
        "delegated_organization_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_version", "grant_id", "action", "status"],
          "properties": {
            "authority_version": { "const": "organization-action-authority.v1" },
            "grant_id": { "$ref": "#/$defs/opaqueId" },
            "action": { "enum": ["member_invite", "member_suspend"] },
            "status": { "const": "active" }
          }
        },
        "compliance_export_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_version", "grant_id", "status", "export_request_id", "export_manifest_sha256", "dossier_owner_approvals"],
          "properties": {
            "authority_version": { "const": "compliance-export-authority.v1" },
            "grant_id": { "$ref": "#/$defs/opaqueId" },
            "status": { "const": "active" },
            "export_request_id": { "$ref": "#/$defs/opaqueId" },
            "export_manifest_sha256": { "$ref": "#/$defs/sha256" },
            "dossier_owner_approvals": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/opaqueId" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["approval_version", "dossier_owner_actor_id", "approval_receipt_id", "dossier_manifest_sha256"],
                "properties": {
                  "approval_version": { "const": "dossier-export-approval.v1" },
                  "dossier_owner_actor_id": { "$ref": "#/$defs/opaqueId" },
                  "approval_receipt_id": { "$ref": "#/$defs/opaqueId" },
                  "dossier_manifest_sha256": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        },
        "legal_hold_approval_authority": {
          "type": "object",
          "additionalProperties": false,
          "x-require-distinct-fields": ["request_actor_id", "approval_actor_id"],
          "x-bind-field-to-authenticated-actor": "approval_actor_id",
          "x-bind-fields-to-immutable-record": {
            "record_type": "legal-hold-request.v1",
            "record_id_field": "request_id",
            "bindings": {
              "request_action": "action",
              "request_actor_id": "actor_id"
            }
          },
          "required": ["authority_version", "request_id", "request_action", "request_actor_id", "approval_actor_id", "approver_basis", "request_record_binding_receipt_sha256", "approval_session_binding_sha256", "separation_of_duties_receipt_sha256", "status"],
          "properties": {
            "authority_version": { "const": "legal-hold-approval-authority.v1" },
            "request_id": { "$ref": "#/$defs/opaqueId" },
            "request_action": { "enum": ["legal_hold_create_request", "legal_hold_release_request"] },
            "request_actor_id": { "$ref": "#/$defs/opaqueId" },
            "approval_actor_id": { "$ref": "#/$defs/opaqueId" },
            "approver_basis": { "enum": ["dossier_reviewer", "organization_admin"] },
            "request_record_binding_receipt_sha256": { "$ref": "#/$defs/sha256" },
            "approval_session_binding_sha256": { "$ref": "#/$defs/sha256" },
            "separation_of_duties_receipt_sha256": { "$ref": "#/$defs/sha256" },
            "status": { "const": "approved" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "identity" } }, "required": ["scope"] },
          "then": {
            "properties": { "action": { "enum": ["oidc_callback", "invitation_acceptance"] } },
            "not": {
              "anyOf": [
                { "required": ["organization_role"] },
                { "required": ["authorization_version"] },
                { "required": ["dossier_role"] },
                { "required": ["delegated_organization_authority"] },
                { "required": ["compliance_export_authority"] },
                { "required": ["legal_hold_approval_authority"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "organization" } }, "required": ["scope"] },
          "then": {
            "required": ["organization_role", "authorization_version"],
            "properties": {
              "action": {
                "enum": [
                  "organization_read", "organization_update", "member_invite", "member_suspend",
                  "member_remove", "member_role_assign", "identity_connection_read",
                  "identity_connection_manage", "policy_read", "policy_manage",
                  "organization_audit_read", "tenant_export_request",
                  "legal_hold_create_approve", "legal_hold_release_approve"
                ]
              }
            },
            "not": { "required": ["dossier_role"] }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "dossier" } }, "required": ["scope"] },
          "then": {
            "required": ["organization_role", "authorization_version", "dossier_role"],
            "properties": {
              "action": {
                "enum": [
                  "dossier_read", "dossier_update", "dossier_member_enrol",
                  "dossier_member_remove", "dossier_owner_transfer", "document_upload",
                  "document_read", "document_delete_request", "extraction_request",
                  "ocr_request", "citation_read", "citation_manage", "evidence_read",
                  "evidence_manage", "task_read", "task_manage", "review_read",
                  "review_submit", "report_read", "report_generate", "dossier_export_request",
                  "retention_purge_request", "legal_hold_read", "legal_hold_create_request",
                  "legal_hold_create_approve", "legal_hold_release_request",
                  "legal_hold_release_approve", "dossier_audit_read"
                ]
              }
            },
            "not": {
              "anyOf": [
                { "required": ["delegated_organization_authority"] },
                { "required": ["compliance_export_authority"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "tenant_export_request" } }, "required": ["action"] },
          "then": { "required": ["compliance_export_authority"] },
          "else": { "not": { "required": ["compliance_export_authority"] } }
        },
        {
          "if": {
            "properties": {
              "organization_role": { "const": "org_owner" },
              "scope": { "const": "organization" }
            },
            "required": ["organization_role", "scope"]
          },
          "then": {
            "not": { "required": ["delegated_organization_authority"] }
          }
        },
        {
          "if": {
            "properties": {
              "organization_role": { "const": "org_admin" },
              "scope": { "const": "organization" }
            },
            "required": ["organization_role", "scope"]
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "organization_read", "organization_update", "member_invite", "member_suspend",
                  "identity_connection_read", "identity_connection_manage", "policy_read",
                  "policy_manage", "organization_audit_read", "tenant_export_request",
                  "legal_hold_create_approve", "legal_hold_release_approve"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "organization_role": { "const": "member" },
              "scope": { "const": "organization" }
            },
            "required": ["organization_role", "scope"]
          },
          "then": {
            "properties": { "action": { "enum": ["organization_read", "identity_connection_read", "policy_read"] } },
            "not": { "required": ["delegated_organization_authority"] }
          }
        },
        {
          "if": {
            "properties": {
              "organization_role": { "const": "auditor" },
              "scope": { "const": "organization" }
            },
            "required": ["organization_role", "scope"]
          },
          "then": {
            "properties": { "action": { "enum": ["organization_read", "identity_connection_read", "policy_read", "organization_audit_read"] } },
            "not": { "required": ["delegated_organization_authority"] }
          }
        },
        {
          "if": { "properties": { "action": { "const": "member_invite" }, "organization_role": { "const": "org_admin" } }, "required": ["action", "organization_role"] },
          "then": {
            "required": ["delegated_organization_authority"],
            "properties": { "delegated_organization_authority": { "properties": { "action": { "const": "member_invite" } } } }
          }
        },
        {
          "if": { "properties": { "action": { "const": "member_suspend" }, "organization_role": { "const": "org_admin" } }, "required": ["action", "organization_role"] },
          "then": {
            "required": ["delegated_organization_authority"],
            "properties": { "delegated_organization_authority": { "properties": { "action": { "const": "member_suspend" } } } }
          }
        },
        {
          "if": {
            "properties": {
              "action": { "enum": ["member_invite", "member_suspend"] },
              "organization_role": { "const": "org_admin" }
            },
            "required": ["action", "organization_role"]
          },
          "else": { "not": { "required": ["delegated_organization_authority"] } }
        },
        {
          "if": { "properties": { "dossier_role": { "const": "contributor" } }, "required": ["dossier_role"] },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "dossier_read", "dossier_update", "document_upload", "document_read",
                  "extraction_request", "ocr_request", "citation_read", "citation_manage",
                  "evidence_read", "evidence_manage", "task_read", "task_manage",
                  "review_read", "report_read", "report_generate", "legal_hold_read",
                  "dossier_audit_read"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "dossier_role": { "const": "reviewer" } }, "required": ["dossier_role"] },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "dossier_read", "document_read", "citation_read", "evidence_read",
                  "task_read", "review_read", "review_submit", "report_read",
                  "report_generate", "legal_hold_read", "legal_hold_create_approve",
                  "legal_hold_release_approve", "dossier_audit_read"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "dossier_role": { "const": "viewer" } }, "required": ["dossier_role"] },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "dossier_read", "document_read", "citation_read", "evidence_read",
                  "task_read", "review_read", "report_read", "legal_hold_read"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["legal_hold_create_request", "legal_hold_release_request"] } }, "required": ["action"] },
          "then": {
            "properties": {
              "scope": { "const": "dossier" },
              "dossier_role": { "const": "owner" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["legal_hold_create_approve", "legal_hold_release_approve"] } }, "required": ["action"] },
          "then": { "required": ["legal_hold_approval_authority"] },
          "else": { "not": { "required": ["legal_hold_approval_authority"] } }
        },
        {
          "if": { "properties": { "action": { "enum": ["legal_hold_create_approve", "legal_hold_release_approve"] }, "scope": { "const": "dossier" } }, "required": ["action", "scope"] },
          "then": {
            "properties": {
              "dossier_role": { "const": "reviewer" },
              "legal_hold_approval_authority": { "properties": { "approver_basis": { "const": "dossier_reviewer" } } }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["legal_hold_create_approve", "legal_hold_release_approve"] }, "scope": { "const": "organization" } }, "required": ["action", "scope"] },
          "then": {
            "properties": {
              "organization_role": { "const": "org_admin" },
              "legal_hold_approval_authority": { "properties": { "approver_basis": { "const": "organization_admin" } } }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "legal_hold_create_approve" } }, "required": ["action"] },
          "then": { "properties": { "legal_hold_approval_authority": { "properties": { "request_action": { "const": "legal_hold_create_request" } } } } }
        },
        {
          "if": { "properties": { "action": { "const": "legal_hold_release_approve" } }, "required": ["action"] },
          "then": { "properties": { "legal_hold_approval_authority": { "properties": { "request_action": { "const": "legal_hold_release_request" } } } } }
        }
      ]
    }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{20,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }
  }
}
