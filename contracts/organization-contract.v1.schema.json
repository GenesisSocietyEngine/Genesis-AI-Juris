{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesis.invalid/contracts/organization-contract.v1.schema.json",
  "title": "GENESIS JURIS organization contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "organization", "authorization"],
  "properties": {
    "contract_version": { "const": "organization-contract.v1" },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "slug", "status", "controller_processor_mode", "data_region", "confidential_document_mode", "policy_versions"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63 },
        "status": { "enum": ["provisioning", "active", "suspended", "closed"] },
        "controller_processor_mode": { "enum": ["controller", "processor", "joint_controller"] },
        "data_region": { "const": "eu" },
        "confidential_document_mode": { "enum": ["disabled", "validation", "approved"] },
        "policy_versions": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/version" }
        },
        "suspension_reason": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "action"],
      "properties": {
        "organization_role": { "enum": ["org_owner", "org_admin", "member", "auditor"] },
        "authorization_version": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["identity", "organization", "dossier"] },
        "action": {
          "enum": [
            "oidc_callback", "invitation_acceptance",
            "organization_admin", "tenant_export",
            "dossier_access", "dossier_export"
          ]
        },
        "dossier_role": { "enum": ["owner", "contributor", "reviewer", "viewer"] },
        "compliance_export_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_version", "grant_id", "status", "dossier_owner_approval_receipt_ids"],
          "properties": {
            "authority_version": { "const": "compliance-export-authority.v1" },
            "grant_id": { "$ref": "#/$defs/opaqueId" },
            "status": { "const": "active" },
            "dossier_owner_approval_receipt_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/opaqueId" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "identity" } }, "required": ["scope"] },
          "then": {
            "properties": { "action": { "enum": ["oidc_callback", "invitation_acceptance"] } },
            "not": {
              "anyOf": [
                { "required": ["organization_role"] },
                { "required": ["authorization_version"] },
                { "required": ["dossier_role"] },
                { "required": ["compliance_export_authority"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "organization" } }, "required": ["scope"] },
          "then": {
            "required": ["organization_role", "authorization_version"],
            "properties": { "action": { "enum": ["organization_admin", "tenant_export"] } },
            "not": { "required": ["dossier_role"] }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "dossier" } }, "required": ["scope"] },
          "then": {
            "required": ["organization_role", "authorization_version", "dossier_role"],
            "properties": { "action": { "enum": ["dossier_access", "dossier_export"] } },
            "not": { "required": ["compliance_export_authority"] }
          }
        },
        {
          "if": { "properties": { "action": { "const": "tenant_export" } }, "required": ["action"] },
          "then": { "required": ["compliance_export_authority"] },
          "else": { "not": { "required": ["compliance_export_authority"] } }
        }
      ]
    }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{20,128}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }
  }
}
